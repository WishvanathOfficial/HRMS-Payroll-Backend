# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=hrms_payroll
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=false

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
MORGAN_FORMAT=dev

# Rate limit (req / min / IP) on /api/v1
RATE_LIMIT_MAX=300

# Auto migration / seeding on startup
AUTO_MIGRATE=true
AUTO_SEED=false

# Authentication — MUST be rotated in any non-dev environment
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Bootstrap admin password used by the seeder; rotate via /auth/change-password on first login
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
