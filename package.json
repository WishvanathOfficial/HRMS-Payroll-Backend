{
    "name": "hrms-payroll-backend",
    "version": "1.0.0",
    "description": "HRMS & Employee Payroll Management Backend — Node.js + Express + TypeScript + Sequelize + MySQL",
    "main": "dist/server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
        "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
        "setup": "npm install && cp -n .env.example .env || true",
        "first-run": "npm run setup && npm run db:setup && npm run dev",
        "db:migrate": "ts-node -r tsconfig-paths/register src/db/cli.ts up",
        "db:migrate:down": "ts-node -r tsconfig-paths/register src/db/cli.ts down",
        "db:migrate:status": "ts-node -r tsconfig-paths/register src/db/cli.ts status",
        "db:seed": "ts-node -r tsconfig-paths/register src/db/cli.ts seed",
        "db:reset": "ts-node -r tsconfig-paths/register src/db/cli.ts reset",
        "db:setup": "npm run db:migrate && npm run db:seed",
        "prepare": "husky install || true",
        "precommit": "lint-staged && npm run test -- --bail --findRelatedTests --passWithNoTests $(git diff --cached --name-only --diff-filter=ACMR | grep -E '\\.(ts|js)$' | tr '\\n' ' ')"
    },
    "lint-staged": {
        "src/**/*.{ts,js}": [
            "prettier --write",
            "eslint --max-warnings=0 --fix"
        ],
        "src/**/*.{json,md}": [
            "prettier --write"
        ]
    },
    "keywords": [
        "hrms",
        "payroll",
        "nodejs",
        "express",
        "typescript",
        "mysql",
        "sequelize"
    ],
    "author": "Wishvanath Sah",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "http-status-codes": "^2.3.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "mysql2": "^3.11.0",
        "sequelize": "^6.37.3",
        "umzug": "^3.8.1",
        "uuid": "^10.0.0",
        "winston": "^3.13.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.14.10",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.1.4",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.7",
        "prettier": "^3.3.3",
        "sequelize-cli": "^6.6.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.3"
    }
}
